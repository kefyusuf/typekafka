# ============================================================
# Broker driver selection
#   in-memory : runs without Kafka, uses EventEmitter (default)
#   confluent : real Kafka via @confluentinc/kafka-javascript
# ============================================================
BROKER_DRIVER=in-memory

# --- In-memory driver (optional) ---
# BROKER_MEMORY_AUTO_COMMIT=true

# --- Confluent driver ---
BROKER_BROKERS=kafka:9092
BROKER_CLIENT_ID=nodejs-kafka-demo
BROKER_SASL_USERNAME=
BROKER_SASL_PASSWORD=

# --- Security (TLS for the confluent driver; empty = disabled) ---
# Paths to PEM files. Combine with BROKER_SASL_* above to get SASL_SSL.
# See docs/guides/security.md and the `security` compose profile.
# BROKER_SSL_CA_PATH=
# BROKER_SSL_CERT_PATH=
# BROKER_SSL_KEY_PATH=

# Optional: enables the Avro codec (driver must be "confluent"). Unset/empty -> JSON codec.
SCHEMA_REGISTRY_URL=

# --- Consumer ---
CONSUMER_GROUP_ID=notification-service
CONSUMER_FROM_BEGINNING=true

# --- App ---
LOG_LEVEL=info

# --- Web UI ---
WEB_PORT=3000
TELEMETRY_GROUP_ID=web-telemetry

# --- Web app transactional outbox ---
# SQLite file holding the orders + outbox tables. Must be writable; compose
# mounts a named volume at /data so orders survive container restarts.
OUTBOX_DB_PATH=data/outbox.db

# --- Customer view ---
# Port the customer-view service listens on (HTTP read model over the compacted customers topic).
CUSTOMER_VIEW_PORT=3001

# --- Demo-only credentials (NON-PRODUCTION defaults) ---
# These seed the SASL_SSL security profile (kafka-secured + *-secured apps).
# They are hardcoded demo secrets — replace before any non-local use.
KAFKA_ADMIN_PASSWORD=admin-secret
BROKER_SASL_APP_PASSWORD=app-secret

# --- kafka-ui schema registry URL (observability/security profiles) ---
KAFKA_UI_SCHEMAREGISTRY_URL=http://localhost:8081

# --- Demo-only HTTP basic-auth for the app UIs and /metrics (Step 2) ---
# Format "user:password" in plain text. When unset, the web UI, customer view,
# and the standalone prometheus /metrics endpoints are OPEN (demo default).
# For production source credentials from a secrets manager, not an env var.
HTTP_BASIC_AUTH=

# --- Grafana admin password (observability profile) ---
# Sets GF_SECURITY_ADMIN_PASSWORD. Replace before any non-local use.
GRAFANA_ADMIN_PASSWORD=admin

# --- kafka-ui login-form auth (observability profile) ---
# Configures kafka-ui's built-in AUTH_TYPE=LOGIN_FORM. Replace before any
# non-local use. Sourced from these env vars in docker-compose.yml.
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=admin

